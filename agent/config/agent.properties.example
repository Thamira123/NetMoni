agent.name=segment-a
agent.local-ip=
agent.network-interface=
agent.version=1.0.0
agent.segment-cidr=192.168.1.0/24
# Networks the administrator has authorized this agent to discover (comma-separated).
# Defaults to segment-cidr; the backend administrator must add the same CIDRs to the agent allowlist.
agent.allowed-cidrs=192.168.1.0/24
agent.backend.host=127.0.0.1
agent.backend.port=9001
agent.backend.connect-timeout-ms=3000
agent.backend.read-timeout-ms=5000
agent.monitoring.interval-seconds=60
agent.discovery.interval-seconds=300
agent.heartbeat.interval-seconds=30
agent.retry.interval-seconds=15
agent.outbox.flush-interval-seconds=2
agent.icmp.timeout-ms=1000
agent.icmp.retries=2
agent.worker-threads=8
agent.tcp.ports=22,80,443
# Optional pre-existing device mappings; discovered devices are registered automatically.
agent.device-ids=
agent.data-directory=./data
agent.snmp.enabled=false
agent.snmp.version=2c
agent.snmp.port=161
agent.snmp.community=
agent.snmp.security-name=
agent.snmp.auth-protocol=SHA256
agent.snmp.auth-passphrase=
agent.snmp.privacy-protocol=AES128
agent.snmp.privacy-passphrase=
agent.snmp.timeout-ms=2000
